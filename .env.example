# Local test configuration. Do not place real credentials in this file.
BACKEND_BASE_URL=http://localhost:8080
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=mentify
TEST_USERNAME=
TEST_PASSWORD=
STUDENT_TEST_USERNAME=
STUDENT_TEST_PASSWORD=
TEACHER_TEST_USERNAME=
TEACHER_TEST_PASSWORD=
ADMIN_TEST_USERNAME=
ADMIN_TEST_PASSWORD=
TEST_AUTH_LOGGING_ENABLED=false
TEST_ENV_ENABLED=false
TEST_REQUIRED_SERVICES=API_GATEWAY,KEYCLOAK
# Calendar integration runs also require: API_GATEWAY,KEYCLOAK,CALENDAR_SERVICE
# TEST-007 workflow tests require the configured Student, Teacher, and Admin test users above.
# Course integration runs also require: API_GATEWAY,KEYCLOAK,COURSE_SERVICE
# Persistent Course CRUD tests additionally require IDs for existing non-production fixtures.
TEST_COURSE_GRADE_ID=
TEST_COURSE_TEACHER_ID=
# Enrollment read fixtures; use approved non-production student/course IDs only.
TEST_ENROLLMENT_STUDENT_ID=
TEST_ENROLLMENT_OTHER_STUDENT_ID=
TEST_ENROLLMENT_COURSE_ID=
TEST_ENROLLMENT_ALTERNATE_COURSE_ID=
TEST_ENROLLMENT_ID=
TEST_ENROLLMENT_WRITE_ENABLED=false
# Assignment fixtures; use approved non-production course, module, student, and assignment IDs.
TEST_ASSIGNMENT_COURSE_ID=
TEST_ASSIGNMENT_MODULE_ID=
TEST_ASSIGNMENT_STUDENT_ID=
TEST_ASSIGNMENT_ID=
TEST_ASSIGNMENT_WRITE_ENABLED=false
# TEST-012 attachment fixtures; use approved non-production assignment,
# submission, and material IDs. Attachment writes are disabled by default.
TEST_ATTACHMENT_ASSIGNMENT_ID=
TEST_ATTACHMENT_SUBMISSION_ID=
TEST_ATTACHMENT_MATERIAL_ID=
TEST_ATTACHMENT_OTHER_MATERIAL_ID=
TEST_ATTACHMENT_WRITE_ENABLED=false
# TEST-013 material fixtures; use approved non-production course/material IDs.
# Material writes are disabled by default and cleanup tests always use dryRun=true.
TEST_MATERIAL_COURSE_ID=
TEST_MATERIAL_ID=
TEST_MATERIAL_WRITE_ENABLED=false
# TEST-014 quiz fixtures; use approved non-production course IDs only.
# Quiz writes are disabled by default; tests create unique quizzes only when enabled.
TEST_QUIZ_COURSE_ID=
TEST_QUIZ_WRITE_ENABLED=false
# TEST-015 attendance fixtures; use approved non-production course and student IDs.
# Attendance writes are disabled by default; write tests create unique sessions.
TEST_ATTENDANCE_COURSE_ID=
TEST_ATTENDANCE_STUDENT_ID=
TEST_ATTENDANCE_WRITE_ENABLED=false
# TEST-016 communication fixtures; use approved non-production course, student, and group IDs.
# Communication writes are disabled by default and create unique temporary groups/messages when enabled.
TEST_COMMUNICATION_COURSE_ID=
TEST_COMMUNICATION_STUDENT_ID=
TEST_COMMUNICATION_GROUP_ID=
TEST_COMMUNICATION_WRITE_ENABLED=false
# TEST-017 exam fixtures; use approved non-production course and enrolled student IDs.
# Exam writes are disabled by default and create unique exams only when enabled.
TEST_EXAM_COURSE_ID=
TEST_EXAM_STUDENT_ID=
TEST_EXAM_SECOND_STUDENT_ID=
TEST_EXAM_WRITE_ENABLED=false
# TEST-018 payment fixtures; use an approved non-production course and student account.
# Provider-dependent writes/refunds are disabled unless explicitly approved and enabled.
TEST_PAYMENT_COURSE_ID=
TEST_PAYMENT_STUDENT_ID=
TEST_PAYMENT_SECOND_STUDENT_ID=
TEST_PAYMENT_WRITE_ENABLED=false
PAYMENT_PROVIDER_TEST_MODE=false
# TEST-019 notification fixtures; use an approved non-production notification ID only when write tests are enabled.
TEST_NOTIFICATION_ID=
TEST_NOTIFICATION_WRITE_ENABLED=false
NOTIFICATION_EMAIL_TEST_MODE=false
# TEST-020 AI fixtures; use synthetic non-production conversation, lesson, material, and course IDs.
# AI provider calls are disabled unless deterministic test mode is explicitly enabled.
TEST_AI_CONVERSATION_ID=
TEST_AI_LESSON_ID=
TEST_AI_MATERIAL_ID=
TEST_AI_COURSE_ID=
TEST_AI_WRITE_ENABLED=false
AI_TEST_MODE=false
AI_PROVIDER=mock
# TEST-021 user fixtures; keep all credentials external to this repository.
TEST_USER_ID=
TEST_USER_WRITE_ENABLED=false
TEST_SUPER_ADMIN_SUPPORTED=false
USER_EMAIL_TEST_MODE=false
# TEST-022 cross-service journeys; gateway tests are disabled unless explicitly enabled.
TEST_E2E_ENABLED=false
TEST_E2E_COURSE_ID=
TEST_E2E_PROVIDER_JOURNEYS_ENABLED=false
# TEST-024 security and resilience regression tests are disabled by default.
TEST_SECURITY_ENABLED=false
TEST_RESILIENCE_ENABLED=false
FAULT_INJECTION_ENABLED=false
TEST_PROVIDER_FAILURE_MODE=false
TEST_MESSAGE_BROKER_FAILURE_MODE=false
TEST_MAIL_FAILURE_MODE=false
# TEST-025 performance baselines are disabled by default and require a dedicated
# non-production environment. Keep request counts and concurrency bounded.
PERFORMANCE_TEST_ENABLED=false
PERFORMANCE_ENVIRONMENT=local
PERFORMANCE_BASE_URL=http://localhost:8080
PERFORMANCE_WARMUP_REQUESTS=5
PERFORMANCE_MEASURED_REQUESTS=30
PERFORMANCE_CONCURRENCY=2
PERFORMANCE_TIMEOUT_MS=10000
PERFORMANCE_MAX_ERROR_RATE_PERCENT=1.0
PERFORMANCE_MAX_P95_MS=2000
PERFORMANCE_MAX_P99_MS=5000
PERFORMANCE_WRITE_ENABLED=false
PERFORMANCE_COURSE_ID=
# TEST-026 contract checks are disabled by default and use the API Gateway.
CONTRACT_TEST_ENABLED=false
CONTRACT_BASE_URL=http://localhost:8080
CONTRACT_SCHEMA_STRICT=false
CONTRACT_FAIL_ON_EXTRA_REQUIRED_FIELDS=false
CONTRACT_FAIL_ON_MISSING_FIELDS=false
CONTRACT_COURSE_ID=
ASSIGNMENT_SERVICE_BASE_URL=http://localhost:8084
READINESS_TIMEOUT_SECONDS=120
READINESS_POLL_INTERVAL_MILLIS=2000
HTTP_CONNECT_TIMEOUT_MILLIS=5000
HTTP_READ_TIMEOUT_MILLIS=10000
API_LOGGING_ENABLED=false

# TEST-028 staging smoke: only set for a locally approved staging target.
# The workflow requires a protected GitHub Environment and typed confirmation.
STAGING_ENVIRONMENT=
STAGING_CONFIRMATION=
STAGING_BASE_URL=
STAGING_KEYCLOAK_BASE_URL=
STAGING_ALLOWED_HOST_SUFFIX=
STAGING_DEPLOYMENT_REVISION=
STAGING_READINESS_TIMEOUT_SECONDS=90
STAGING_POLL_INTERVAL_SECONDS=3
STAGING_REQUEST_TIMEOUT_SECONDS=8

# Mentify service URLs used by the integration profile.
API_GATEWAY_BASE_URL=http://localhost:8080
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=mentify
CONFIG_SERVER_BASE_URL=http://localhost:8888
EUREKA_BASE_URL=http://localhost:8761
USER_SERVICE_BASE_URL=http://localhost:8081
COURSE_SERVICE_BASE_URL=http://localhost:8082
ENROLLMENT_SERVICE_BASE_URL=http://localhost:8083
ASSIGNMENT_SERVICE_BASE_URL=http://localhost:8084
COMMUNICATION_SERVICE_BASE_URL=http://localhost:8086
ATTENDANCE_SERVICE_BASE_URL=http://localhost:8087
AI_SERVICE_BASE_URL=http://localhost:8088
EXAM_SERVICE_BASE_URL=http://localhost:8089
PAYMENT_SERVICE_BASE_URL=http://localhost:8090
MATERIAL_SERVICE_BASE_URL=http://localhost:8091
CALENDAR_SERVICE_BASE_URL=http://localhost:8092
NOTIFICATION_SERVICE_BASE_URL=http://localhost:8093
